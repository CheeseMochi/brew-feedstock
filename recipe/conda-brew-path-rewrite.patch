diff --git a/Library/Homebrew/keg_relocate.rb b/Library/Homebrew/keg_relocate.rb
index ce43f2f..c94bfbd 100644
--- a/Library/Homebrew/keg_relocate.rb
+++ b/Library/Homebrew/keg_relocate.rb
@@ -185,6 +185,10 @@ class Keg
     relocation.add_replacement_pair(:prefix, PREFIX_PLACEHOLDER, HOMEBREW_PREFIX.to_s)
     relocation.add_replacement_pair(:cellar, CELLAR_PLACEHOLDER, HOMEBREW_CELLAR.to_s)
     relocation.add_replacement_pair(:repository, REPOSITORY_PLACEHOLDER, HOMEBREW_REPOSITORY.to_s)
+    # Bottles built for the stock macOS prefixes hardcode absolute paths (not
+    # placeholder tokens), so rewrite those literally to the conda-scoped prefix.
+    relocation.add_replacement_pair(:default_macos_arm, "/opt/homebrew", HOMEBREW_PREFIX.to_s)
+    relocation.add_replacement_pair(:default_macos_intel, "/usr/local", HOMEBREW_PREFIX.to_s)
     relocation.add_replacement_pair(:library, LIBRARY_PLACEHOLDER, HOMEBREW_LIBRARY.to_s)
     relocation.add_replacement_pair(:perl, PERL_PLACEHOLDER, "#{HOMEBREW_PREFIX}/opt/perl/bin/perl")
     if (openjdk = openjdk_dep_name_if_applicable)
@@ -306,11 +310,18 @@ class Keg
         # Rejoin strings by null bytes.
         patched_binary = binary_strings.join(NULL_BYTE)
         if patched_binary.size != binary.size
-          raise <<~EOS
-            Patching failed!  Original and patched binary sizes do not match.
-            Original size: #{binary.size}
-            Patched size: #{patched_binary.size}
+          # conda-brew: the conda-scoped prefix is virtually always longer than
+          # old_prefix, and in-place null-padded substitution can only shrink or
+          # preserve length, never grow it. Leave this file's embedded literal
+          # path unpatched rather than aborting the whole install -- dynamic
+          # linkage (install names/rpaths) is relocated separately and safely
+          # by replace_placeholders_with_locations regardless of this skip.
+          opoo <<~EOS
+            Skipping build-prefix patch for #{file}: replacement text is longer
+            than the original (#{binary.size} -> #{patched_binary.size} bytes).
+            Some embedded absolute paths may still reference #{old_prefix}.
           EOS
+          next
         end
 
         file.atomic_write patched_binary
diff --git a/bin/brew b/bin/brew
index 46b6b39..1f0d4be 100755
--- a/bin/brew
+++ b/bin/brew
@@ -87,6 +87,12 @@ if [[ -L "${HOMEBREW_BREW_FILE}" ]]
 then
   BREW_FILE_DIRECTORY="$(symlink_target_directory "${HOMEBREW_BREW_FILE}" "${BREW_FILE_DIRECTORY}")"
   HOMEBREW_REPOSITORY="${BREW_FILE_DIRECTORY%/*}"
+  # conda-brew: HOMEBREW_PREFIX above was derived from $0's literal (unresolved)
+  # path, which is one directory too shallow when reached via our one-hop
+  # $CONDA_PREFIX/bin/brew -> ../homebrew/bin/brew symlink. Align it with the
+  # symlink-resolved repository so `brew link` targets homebrew/bin, not the
+  # conda env's own shared bin/.
+  HOMEBREW_PREFIX="${HOMEBREW_REPOSITORY}"
 fi
 
